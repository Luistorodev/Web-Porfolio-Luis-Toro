---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../data/i18n';

const copy = ui.en;
const experience = [
  { role: 'Product Design Engineer & Design System Lead', company: 'Ontop LLC', period: `2024 — ${copy.cv.present}` },
  { role: 'Product Designer', company: 'Circulo de Credito', period: '2023 — 2024' },
  { role: 'AI Product Designer', company: 'Kmeleon Tech', period: '2023' },
  { role: 'Product Designer', company: 'Scotiabank Colpatria', period: '2022 — 2023' },
  { role: 'UX/UI Consultant', company: 'Serempre', period: '2021' },
  { role: 'Junior UX/UI Designer', company: 'Finsocial', period: '2020' },
];
---

<Layout lang="en" title={copy.seo.cv.title} description={copy.seo.cv.description}>
  <div class="bg-[var(--color-page)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="cv" currentPath="/cv" lang="en" />
    <main id="main" class="flex flex-1 flex-col items-center overflow-clip w-full max-w-[1440px] mx-auto animate-[fadeIn_0.4s_ease-out]">
      <div class="flex flex-1 flex-col gap-4 md:gap-6 items-center justify-center px-4 md:px-6 py-16 md:py-24 w-full max-w-[745px]">
        <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-(family-name:--font-inter)">{copy.cv.title}</h1>

        <div class="flex flex-col gap-6 md:gap-8 mt-4 w-full max-w-[500px]">
          <div>
            <h2 class="text-[var(--color-text-muted)] text-[12px] md:text-[14px] uppercase font-(family-name:--font-geist-mono) mb-3">{copy.cv.experience}</h2>
            {experience.map((exp) => (
              <div class="flex flex-col md:flex-row md:justify-between py-3 border-b border-[var(--color-border)] gap-1 md:gap-0">
                <div class="flex flex-col gap-0.5">
                  <span class="text-[var(--color-text-strong)] text-sm md:text-base font-(family-name:--font-inter) font-medium">{exp.role}</span>
                  <span class="text-[var(--color-text-secondary)] text-[13px] font-(family-name:--font-inter)">{exp.company}</span>
                </div>
                <span class="text-[var(--color-text-muted)] text-[11px] md:text-[13px] font-(family-name:--font-geist-mono) uppercase whitespace-nowrap">{exp.period}</span>
              </div>
            ))}
          </div>

          <div>
            <h2 class="text-[var(--color-text-muted)] text-[12px] md:text-[14px] uppercase font-(family-name:--font-geist-mono) mb-3">{copy.cv.education}</h2>
            <div class="flex flex-col md:flex-row md:justify-between py-3 border-b border-[var(--color-border)] gap-1 md:gap-0">
              <div class="flex flex-col gap-0.5">
                <span class="text-[var(--color-text-strong)] text-sm md:text-base font-(family-name:--font-inter) font-medium">{copy.cv.graphicDesign}</span>
                <span class="text-[var(--color-text-secondary)] text-[13px] font-(family-name:--font-inter)">Universidad Autónoma del Caribe</span>
              </div>
              <span class="text-[var(--color-text-muted)] text-[11px] md:text-[13px] font-(family-name:--font-geist-mono) uppercase whitespace-nowrap">2016 — 2020</span>
            </div>
          </div>

          <div class="flex justify-center mt-4">
            <a href="/assets/Luis-Toro-Product-Design-Engineer-CV.pdf" class="bg-[var(--color-accent)] text-white text-base font-(family-name:--font-geist-mono) uppercase px-6 py-3 rounded-lg no-underline hover:opacity-90 transition-opacity duration-200">
              {copy.cv.download}
            </a>
          </div>
        </div>
      </div>
    </main>
    <Footer lang="en" />
  </div>
</Layout>
