---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectContent from '../../components/ProjectContent.astro';
import CaseStudyNavigation from '../../components/CaseStudyNavigation.astro';
import { getImage } from 'astro:assets';
import { allProjects, type Project } from '../../data/projects';
import { getCaseStudy } from '../../data/caseStudies';
import { projectCopy, ui } from '../../data/i18n';

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

const content = getCaseStudy(project.slug, 'en');
const projectText = projectCopy[project.slug as keyof typeof projectCopy];
const localizedContent = content && projectText ? { ...content, ...projectText.en } : content;
const seo = projectText
  ? { title: `${projectText.en.title} | Luis Toro`, description: projectText.en.subtitle }
  : ui.en.seo.home;
const ogImage = localizedContent
  ? await getImage({ src: localizedContent.cover.src, width: 1200, height: 630, fit: 'cover', format: 'png' })
  : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: project.title.en, item: pageUrl },
  ],
};
const projectIndex = allProjects.findIndex((item) => item.slug === project.slug);
const previousProject = projectIndex > 0 ? allProjects[projectIndex - 1] : undefined;
const nextProject = projectIndex >= 0 && projectIndex < allProjects.length - 1 ? allProjects[projectIndex + 1] : undefined;
---

<Layout lang="en" title={seo.title} description={seo.description} image={ogImage?.src} type="article" jsonLd={breadcrumbJsonLd}>
  <div class="bg-[var(--color-page)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="work" currentPath={`/work/${project.slug}`} lang="en" />

    <main id="main" class="flex flex-col items-center overflow-clip w-full max-w-[1440px] mx-auto pt-8 md:pt-12 animate-[fadeIn_0.4s_ease-out]">
      {localizedContent ? (
        <ProjectContent content={localizedContent} lang="en" />
      ) : (
        <div class="flex flex-1 flex-col gap-4 md:gap-6 items-center justify-center px-4 md:px-6 py-16 md:py-24 w-full max-w-[745px]">
          <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-['Inter'] text-center">
            {project.title.en}
          </h1>
          <p class="text-[var(--color-text-secondary)] text-[13px] leading-tight font-['Inter'] text-center max-w-[500px]">
            {ui.en.emptyProject} {project.company} &middot; {project.year}
          </p>
        </div>
      )}
      <CaseStudyNavigation lang="en" previous={previousProject} next={nextProject} />
    </main>

    <Footer lang="en" />
  </div>
</Layout>
