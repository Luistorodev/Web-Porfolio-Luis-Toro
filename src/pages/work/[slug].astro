---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectContent from '../../components/ProjectContent.astro';
import { allProjects, type Project } from '../../data/projects';
import { getCaseStudy } from '../../data/caseStudies';
import { projectCopy, ui } from '../../data/i18n';

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

const content = getCaseStudy(project.slug, 'en');
const projectText = projectCopy[project.slug as keyof typeof projectCopy];
const localizedContent = content && projectText ? { ...content, ...projectText.en } : content;
const seo = projectText
  ? { title: `${projectText.en.title} | Luis Toro`, description: projectText.en.subtitle }
  : ui.en.seo.home;
---

<Layout lang="en" title={seo.title} description={seo.description}>
  <div class="bg-[var(--color-page)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="work" currentPath={`/work/${project.slug}`} lang="en" />

    <div class="flex flex-col items-center overflow-clip w-full max-w-[1440px] mx-auto pt-8 md:pt-12 animate-[fadeIn_0.4s_ease-out]">
      {localizedContent ? (
        <ProjectContent content={localizedContent} lang="en" />
      ) : (
        <div class="flex flex-1 flex-col gap-4 md:gap-6 items-center justify-center px-4 md:px-6 py-16 md:py-24 w-full max-w-[745px]">
          <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-['Inter'] text-center">
            {project.title.en}
          </h1>
          <p class="text-[var(--color-text-secondary)] text-[13px] leading-tight font-['Inter'] text-center max-w-[500px]">
            {ui.en.emptyProject} {project.company} &middot; {project.year}
          </p>
        </div>
      )}
    </div>

    <Footer lang="en" />
  </div>
</Layout>
