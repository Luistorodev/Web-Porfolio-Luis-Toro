---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import HomeIntro from '../../components/home/HomeIntro.astro';
import WorkShowcase from '../../components/home/WorkShowcase.astro';
import PlayCarousel from '../../components/home/PlayCarousel.astro';
import HomeStory from '../../components/home/HomeStory.astro';
import ContactBlock from '../../components/home/ContactBlock.astro';
import { ui } from '../../data/i18n';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luis Toro',
  jobTitle: 'Product Design Engineer',
  url: Astro.site?.href,
  sameAs: [
    'https://www.linkedin.com/in/luistorodg/',
    'https://github.com/Luistorodev',
  ],
};
---

<Layout lang="es" title={ui.es.seo.home.title} description={ui.es.seo.home.description} jsonLd={personJsonLd}>
  <div class="bg-[var(--color-page)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="work" currentPath="/es" lang="es" />
    <main id="main" class="flex flex-col gap-20 md:gap-32 items-center overflow-clip w-full max-w-[1440px] mx-auto pt-8 md:pt-12 animate-[fadeIn_0.4s_ease-out]">
      <HomeIntro lang="es" />
      <WorkShowcase lang="es" />
      <PlayCarousel lang="es" />
      <HomeStory lang="es" />
    </main>
    <ContactBlock lang="es" />
  </div>
</Layout>
