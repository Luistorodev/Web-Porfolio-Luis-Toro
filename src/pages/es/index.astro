---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import PortfolioGrid from '../../components/PortfolioGrid.astro';
import BuiltByMe from '../../components/BuiltByMe.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../data/i18n';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luis Toro',
  jobTitle: 'Product Design Engineer',
  url: Astro.site?.href,
  sameAs: [
    'https://www.linkedin.com/in/luistorodg/',
    'https://github.com/Luistorodev',
  ],
};
---

<Layout lang="es" title={ui.es.seo.home.title} description={ui.es.seo.home.description} jsonLd={personJsonLd}>
  <div class="bg-[var(--color-page)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="work" currentPath="/es" lang="es" />
    <main id="main" class="flex flex-col gap-8 md:gap-12 items-center overflow-clip w-full max-w-[1440px] mx-auto py-8 md:py-12 animate-[fadeIn_0.4s_ease-out]">
      <Hero lang="es" />
      <PortfolioGrid lang="es" />
      <BuiltByMe lang="es" />
    </main>
    <Footer lang="es" />
  </div>
</Layout>
