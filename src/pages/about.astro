---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AboutGallery from '../components/AboutGallery.astro';
import { ui } from '../data/i18n';

const copy = ui.en;
---

<Layout lang="en" title={copy.seo.about.title} description={copy.seo.about.description}>
  <div class="bg-[var(--color-page-alt)] flex flex-col min-h-screen w-full transition-colors duration-200">
    <Navbar currentPage="about" currentPath="/about" lang="en" />
    <main id="main" class="flex flex-1 flex-col gap-8 md:gap-12 items-center overflow-clip w-full max-w-[1440px] mx-auto py-8 md:py-12 animate-[fadeIn_0.4s_ease-out]">
      <div class="flex flex-col gap-4 px-4 md:px-6 w-full max-w-[968px]">
        <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-['Inter']">
          {copy.about.title}
        </h1>
        <p class="text-[var(--color-text-secondary)] text-[13px] leading-tight font-['Inter']">
          {copy.about.description}
        </p>
      </div>

      <AboutGallery lang="en" />
    </main>
    <Footer lang="en" />
  </div>
</Layout>
