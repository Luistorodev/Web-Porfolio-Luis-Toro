---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import { ui, getLocalizedPath, type Language } from '../data/i18n';

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  /** Root-relative URL of the page's og:image (1200x630). Defaults to the brand image. */
  image?: string;
  type?: 'website' | 'article';
  /** One or more JSON-LD objects to embed in the head. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = 'en',
  title = 'Luis Toro | Product Designer',
  description = 'Portfolio of Luis Toro, Product Designer.',
  image,
  type = 'website',
  jsonLd,
} = Astro.props;

// ── Canonical + hreflang (derived from the current URL) ───
const site = Astro.site!;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, site).href;
const enPath = pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enUrl = new URL(enPath, site).href;
const esUrl = new URL(getLocalizedPath(enPath, 'es'), site).href;

// ── Open Graph image ──────────────────────────────────────
const ogImage = new URL(image ?? '/og-image.png', site).href;

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_ES';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Luis Toro" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical + hreflang EN/ES -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Luis Toro" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <script is:inline>
      (() => {
        const storageKey = 'theme';
        let theme = 'light';

        try {
          const savedTheme = localStorage.getItem(storageKey);
          theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'light';
        } catch {
          theme = 'light';
        }

        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400&family=Instrument+Serif:ital@0;1&family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&display=swap" rel="stylesheet" />
  </head>
  <body class="font-['Inter']">
    <a href="#main" class="skip-link">{ui[lang].skipToContent}</a>
    <slot />
    <Cursor />
  </body>
</html>
