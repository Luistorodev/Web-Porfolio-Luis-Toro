---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import Cursor from '../components/Cursor.astro';
import { Font } from 'astro:assets';
import { ui, getLocalizedPath, type Language } from '../data/i18n';

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  /** Root-relative URL of the page's og:image (1200x630). Defaults to the brand image. */
  image?: string;
  type?: 'website' | 'article';
  /** One or more JSON-LD objects to embed in the head. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = 'en',
  title = 'Luis Toro | Product Design Engineer',
  description = 'Portfolio of Luis Toro, Product Design Engineer.',
  image,
  type = 'website',
  jsonLd,
} = Astro.props;

// ── Canonical + hreflang (derived from the current URL) ───
const site = Astro.site!;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, site).href;
const enPath = pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enUrl = new URL(enPath, site).href;
const esUrl = new URL(getLocalizedPath(enPath, 'es'), site).href;

// ── Open Graph image ──────────────────────────────────────
const ogImage = new URL(image ?? '/og-image.png', site).href;

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_ES';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// ── Inline scripts (hashed for the CSP) ───────────────────
// Astro only hashes the scripts it bundles, so the `is:inline` ones are built here as
// single-line strings: the exact same string is hashed and rendered, so they can't drift.
const cspHash = (source: string) => `sha256-${createHash('sha256').update(source, 'utf8').digest('base64')}` as const;

const clarityProjectId = 'xyuxz9wyf4';
const clarityScript = `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarityProjectId}");`;

const themeScript = `(()=>{const storageKey='theme';let theme='light';try{const savedTheme=localStorage.getItem(storageKey);theme=savedTheme==='light'||savedTheme==='dark'?savedTheme:'light';}catch{theme='light';}document.documentElement.dataset.theme=theme;})();`;

// Escape "<" so a value can never close the script tag (JSON-LD stays valid JSON).
const jsonLdPayloads = jsonLdItems.map((item) => JSON.stringify(item).replace(/</g, '\\u003c'));

// Register every inline script so the CSP meta can allow it.
for (const source of [clarityScript, themeScript, ...jsonLdPayloads]) {
  Astro.csp?.insertScriptHash({ hash: cspHash(source), kind: 'default' });
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Luis Toro" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical + hreflang EN/ES -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Luis Toro" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    {jsonLdPayloads.map((payload) => (
      <script is:inline type="application/ld+json" set:html={payload} />
    ))}

    <!-- Microsoft Clarity -->
    <script is:inline set:html={clarityScript} />

    <script is:inline set:html={themeScript} />
    <!-- Self-hosted fonts with preload + metric-matched fallbacks to avoid the font swap flash -->
    <Font cssVariable="--font-inter" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-geist-mono" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-instrument-serif" />
  </head>
  <body class="font-(family-name:--font-inter)">
    <a href="#main" class="skip-link">{ui[lang].skipToContent}</a>
    <slot />
    <Cursor label={ui[lang].viewProject} />
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      // Inertial wheel scrolling; Lenis itself turns off for prefers-reduced-motion. Touch keeps native scrolling.
      new Lenis({
        autoRaf: true,
        lerp: 0.09,
        anchors: true,
        prevent: (node) => node.classList.contains('pswp'),
      });
    </script>
  </body>
</html>
