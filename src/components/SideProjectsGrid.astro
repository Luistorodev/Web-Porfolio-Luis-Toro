---
import { Image } from 'astro:assets';
import { allSideProjects, type SideProject } from '../data/sideProjects';
import { ui, type Language } from '../data/i18n';

interface Props {
  lang?: Language;
  /** id of a visible heading outside the grid; when set, the hidden fallback heading is skipped. */
  labelledBy?: string;
  /** 'home': 3 columns with descriptions (Built by me). 'page': original 2-column side projects layout. */
  variant?: 'page' | 'home';
}

const { lang = 'en', labelledBy, variant = 'page' } = Astro.props;
const isHome = variant === 'home';
const projects = allSideProjects.filter((project) => project.featured);
const widths = [400, 680, 1360];
const sizes = isHome ? '(min-width: 1024px) 460px, (min-width: 768px) 680px, calc(100vw - 2rem)' : '(min-width: 768px) 680px, calc(100vw - 2rem)';

function title(project: SideProject) {
  return project.title[lang];
}

function placeholder(project: SideProject) {
  return title(project).split(' ').map((word) => word[0]).join('').slice(0, 3);
}
---

<section aria-labelledby={labelledBy ?? "side-projects-heading"} class="w-full px-4 md:px-6">
  {!labelledBy && <h2 id="side-projects-heading" class="sr-only">{ui[lang].projectsSection}</h2>}
  <div class={`grid grid-cols-1 md:grid-cols-2 ${isHome ? 'lg:grid-cols-3' : ''} gap-8 w-full`}>
    {projects.map((project) => (
      <article class={`${project.disabled ? 'project-card-disabled' : 'project-card group'} flex flex-col gap-0.5 w-full ${isHome ? 'md:h-[380px]' : 'md:h-[353px]'}`}>
        {project.externalUrl && !project.disabled ? (
          <a href={project.externalUrl} target="_blank" rel="noopener noreferrer" class="flex flex-col gap-0.5 h-full w-full no-underline cursor-none">
            <div class="h-[250px] md:flex-1 md:min-h-0 w-full rounded-xs overflow-hidden transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]">
              {project.image ? (
                <Image src={project.image} alt={title(project)} widths={widths} sizes={sizes} format="webp" loading="lazy" decoding="async" class="block w-full h-full object-cover" />
              ) : (
                <div class="bg-[var(--color-placeholder)] w-full h-full flex items-center justify-center">
                  <span class="text-[var(--color-text-primary)] text-sm font-(family-name:--font-geist-mono) uppercase">{placeholder(project)}</span>
                </div>
              )}
            </div>
            <div class="flex flex-col gap-0.5 text-sm w-full md:flex-row md:items-start md:justify-between md:h-[19px] md:text-base md:whitespace-nowrap">
              <h3 class="font-medium text-[var(--color-text-strong)] font-(family-name:--font-inter)">{title(project)}</h3>
              {project.year && <p class="text-[var(--color-text-secondary)] uppercase font-(family-name:--font-geist-mono)">{project.year}</p>}
            </div>
            {isHome && project.description && <p class="text-[var(--color-text-secondary)] text-[13px] md:text-sm leading-snug line-clamp-2 font-(family-name:--font-inter)">{project.description[lang]}</p>}
          </a>
        ) : (
          <div class="flex flex-col gap-0.5 h-full w-full" aria-disabled={project.disabled ? 'true' : undefined}>
            <div class="h-[250px] md:flex-1 md:min-h-0 w-full rounded-xs overflow-hidden relative">
              {project.image ? (
                <Image src={project.image} alt={title(project)} widths={widths} sizes={sizes} format="webp" loading="lazy" decoding="async" class="block w-full h-full object-cover" />
              ) : (
                <div class="bg-[var(--color-placeholder)] absolute inset-0 flex items-center justify-center">
                  <span class="text-[var(--color-text-primary)] text-sm font-(family-name:--font-geist-mono) uppercase">{placeholder(project)}</span>
                </div>
              )}
            </div>
            <div class="flex flex-col gap-0.5 text-sm w-full md:flex-row md:items-start md:justify-between md:h-[19px] md:text-base md:whitespace-nowrap">
              <h3 class="font-medium text-[var(--color-text-strong)] font-(family-name:--font-inter)">{title(project)}</h3>
              {project.year && <p class="text-[var(--color-text-secondary)] uppercase font-(family-name:--font-geist-mono)">{project.year}</p>}
            </div>
            {isHome && project.description && <p class="text-[var(--color-text-secondary)] text-[13px] md:text-sm leading-snug line-clamp-2 font-(family-name:--font-inter)">{project.description[lang]}</p>}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
