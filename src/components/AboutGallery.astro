---
import { Image } from 'astro:assets';
import type { Language } from '../data/i18n';
import pcBuild from '../assets/about/first-pc-build.webp';
import personal2 from '../assets/about/personal-2.jpg';
import img0185 from '../assets/about/IMG_0185.jpg';
import img0552 from '../assets/about/IMG_0552.jpg';
import img0574 from '../assets/about/IMG_0574.jpg';
import img0800 from '../assets/about/IMG_0800.jpg';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;

// TODO(luis): confirmar los alts propuestos de la galería (identificados visualmente; valida que describan lo que quieres transmitir).
const images = {
  en: [
    { src: pcBuild, alt: 'Custom PC build with RGB fans' },
    { src: personal2, alt: '3D-printed Benchy test boat' },
    { src: img0185, alt: 'Candlelight string concert' },
    { src: img0552, alt: 'Dongdaemun Design Plaza in Seoul' },
    { src: img0574, alt: 'N Seoul Tower through tree branches' },
    { src: img0800, alt: 'Park bench under a tree covered in autumn leaves' },
  ],
  es: [
    { src: pcBuild, alt: 'PC personalizado con ventiladores RGB' },
    { src: personal2, alt: 'Barco Benchy de prueba impreso en 3D' },
    { src: img0185, alt: 'Concierto de cuerdas a la luz de las velas' },
    { src: img0552, alt: 'Dongdaemun Design Plaza en Seúl' },
    { src: img0574, alt: 'Torre N de Seúl entre ramas de árboles' },
    { src: img0800, alt: 'Banca de parque bajo un árbol cubierto de hojas de otoño' },
  ],
};

// Cells are ~442px wide at lg (3 cols), ~680px at md (2 cols), full-width on mobile.
const widths = [400, 442, 680, 884];
const sizes = '(min-width: 1024px) 442px, (min-width: 768px) 680px, calc(100vw - 2rem)';
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 px-4 md:px-6 w-full">
  {images[lang].map((image) => (
    <div class="aspect-[1.15] lg:aspect-[1.27] w-full rounded-lg overflow-hidden">
      <Image src={image.src} alt={image.alt} widths={widths} sizes={sizes} format="webp" loading="lazy" decoding="async" class="block w-full h-full object-cover" />
    </div>
  ))}
</div>
