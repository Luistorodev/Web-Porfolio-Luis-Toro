---
import { ui, type Language } from '../../data/i18n';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const copy = ui[lang];
const email = 'luispipe1998@hotmail.com';
const links = [
  { label: copy.home.resume, href: '/assets/Luis-Toro-Product-Design-Engineer-CV.pdf' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/luistorodg/' },
  { label: 'GitHub', href: 'https://github.com/Luistorodev' },
];
---

<!-- Always dark, in both themes: it closes the page like the reference footer. -->
<footer class="w-full bg-[#0a0a0b] text-white font-(family-name:--font-inter)">
  <div class="w-full max-w-[1440px] mx-auto px-4 md:px-12 lg:px-[84px] py-16 md:py-24 flex flex-col lg:flex-row lg:items-center justify-between gap-12">
    <p class="text-[36px] md:text-[48px] leading-[1.1] tracking-[-0.02em] font-semibold max-w-[520px]">
      {copy.home.contactLead} <span class="text-white/50">{copy.home.contactRest}</span>
    </p>
    <div class="flex flex-col gap-8">
      <a href={`mailto:${email}`} class="text-[17px] md:text-[18px] text-white no-underline hover:text-[var(--color-accent)] transition-colors duration-200 break-all">{email}</a>
      <ul class="flex flex-wrap gap-x-10 gap-y-4 list-none m-0 p-0">
        {links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[16px] text-white no-underline hover:text-[var(--color-accent)] transition-colors duration-200">
              {link.label}
              <svg class="w-4 h-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="text-[13px] text-white/40 font-(family-name:--font-geist-mono) uppercase">{copy.footer}</p>
    </div>
  </div>
</footer>
