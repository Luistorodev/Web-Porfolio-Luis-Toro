---
import type { ProjectContent, ProjectSection } from '../data/legalTechContent';
import { ui, type Language } from '../data/i18n';
import ImageBlock from './ImageBlock.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  content: ProjectContent;
  lang?: Language;
}

const { content, lang = 'en' } = Astro.props;
const { cover, meta, sections } = content;

function renderBody(body: string[]) {
  const items: { type: 'p' | 'ul' | 'quote' | 'heading-serif'; content: string[] }[] = [];
  let bulletGroup: string[] = [];

  for (const p of body) {
    if (p.startsWith('•')) {
      bulletGroup.push(p.replace(/^•\s*/, ''));
    } else {
      if (bulletGroup.length > 0) {
        items.push({ type: 'ul', content: bulletGroup });
        bulletGroup = [];
      }
      if (p.startsWith("'''") || p.startsWith('"""')) {
        items.push({ type: 'heading-serif', content: [p.replace(/^['''"""]+/, '').replace(/['''"""]+$/, '')] });
      } else if (p.startsWith("''") || p.startsWith('"')) {
        items.push({ type: 'quote', content: [p.replace(/^[''""]+/, '').replace(/[''""]+$/, '')] });
      } else {
        items.push({ type: 'p', content: [p] });
      }
    }
  }
  if (bulletGroup.length > 0) {
    items.push({ type: 'ul', content: bulletGroup });
  }

  return items;
}
---

<div class="border-b border-[var(--color-border-strong)] pb-8 w-full">
  <div class="mx-auto max-w-[770px] px-4 md:px-0 flex flex-col gap-4">

    <!-- Hero -->
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-(family-name:--font-inter)">
          {content.title}
        </h1>
        <p class="text-[var(--color-text-muted)] text-sm md:text-[14px] uppercase font-(family-name:--font-geist-mono)">
          {content.subtitle}
        </p>
      </div>
      <ImageBlock image={cover} priority />
    </div>

    <!-- Meta bar -->
    <div class="flex gap-4 text-sm md:text-[14px]">
      <div class="flex flex-1 flex-col gap-1.5">
        <span class="text-[var(--color-text-muted)] uppercase font-(family-name:--font-geist-mono)">{ui[lang].projectMeta.role}:</span>
        <span class="text-[var(--color-text-strong)] font-(family-name:--font-inter)">{meta.role}</span>
      </div>
      <div class="flex flex-1 flex-col gap-1.5">
        <span class="text-[var(--color-text-muted)] uppercase font-(family-name:--font-geist-mono)">{ui[lang].projectMeta.timeline}</span>
        <span class="text-[var(--color-text-strong)] font-(family-name:--font-inter)">{meta.timeline}</span>
      </div>
      <div class="flex flex-1 flex-col gap-1.5">
        <span class="text-[var(--color-text-muted)] uppercase font-(family-name:--font-geist-mono)">{ui[lang].projectMeta.skills}</span>
        <div class="text-[var(--color-text-strong)] font-(family-name:--font-inter) leading-[1.2]">
          {meta.skills.map((skill: string) => <p>{skill}</p>)}
        </div>
      </div>
    </div>

    <!-- Content sections -->
    {sections.map((section: ProjectSection) => (
      section.layout ? (
        <div class={`flex flex-col md:flex-row gap-4 ${section.layout === 'side-text-left' ? 'md:flex-row' : ''} ${section.layout === 'side-text-right' ? 'md:flex-row' : ''}`}>
          {section.layout === 'side-text-right' ? (
            <>
              <div class="flex-1">
                {section.image && (
                  <>
                    <ImageBlock image={section.image} />
                    {section.image.caption && (
                      <p class="text-[var(--color-text-secondary)] text-[13px] font-(family-name:--font-geist-mono) leading-[1.2] uppercase text-right">{section.image.caption}</p>
                    )}
                  </>
                )}
              </div>
              <div class="flex-1 flex flex-col justify-end gap-3">
                {section.body && (
                  <div class="flex flex-col gap-3">
                    {renderBody(section.body).map((item) => (
                      item.type === 'heading-serif' ? (
                        item.content.map((h: string) => (
                          <p class="text-[var(--color-text-primary)] text-[20px] md:text-[24px] leading-[1.2] font-(family-name:--font-instrument-serif)">{h}</p>
                        ))
                      ) : (
                        item.content.map((p: string) => {
                          const html = p.replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>').replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                          return <p class="text-[var(--color-text-secondary)] text-[13px] leading-relaxed font-(family-name:--font-inter)" set:html={html} />;
                        })
                      )
                    ))}
                  </div>
                )}
              </div>
            </>
          ) : (
            <>
              <div class="flex-1 flex flex-col justify-end gap-3">
                {section.body && (
                  <div class="flex flex-col gap-3">
                    {renderBody(section.body).map((item) => (
                      item.type === 'heading-serif' ? (
                        item.content.map((h: string) => (
                          <p class="text-[var(--color-text-primary)] text-[20px] md:text-[24px] leading-[1.2] font-(family-name:--font-instrument-serif)">{h}</p>
                        ))
                      ) : (
                        item.content.map((p: string) => {
                          const html = p.replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>').replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                          return <p class="text-[var(--color-text-secondary)] text-[13px] leading-relaxed font-(family-name:--font-inter)" set:html={html} />;
                        })
                      )
                    ))}
                  </div>
                )}
              </div>
              <div class="flex-1">
                {section.image && (
                  <>
                    <ImageBlock image={section.image} />
                    {section.image.caption && (
                      <p class="text-[var(--color-text-secondary)] text-[13px] font-(family-name:--font-geist-mono) leading-[1.2] uppercase text-right">{section.image.caption}</p>
                    )}
                  </>
                )}
              </div>
            </>
          )}
        </div>
      ) : (
      <div class="flex flex-col gap-4">
        {section.label && (
          <p class="text-[var(--color-text-muted)] text-sm md:text-[14px] uppercase font-(family-name:--font-geist-mono)">{section.label}</p>
        )}
        {section.heading && (
          <h2 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-(family-name:--font-inter)">{section.heading}</h2>
        )}
        {section.subheading && (
          <h3 class="font-semibold text-[var(--color-text-strong)] text-[18px] md:text-[20px] leading-tight font-(family-name:--font-inter)">{section.subheading}</h3>
        )}
        {section.body && (
          <div class="flex flex-col gap-3">
            {renderBody(section.body).map((item) => (
              item.type === 'ul' ? (
                <ul class="list-disc pl-5 space-y-1.5 text-[var(--color-text-secondary)] text-[13px] leading-relaxed font-(family-name:--font-inter)">
                  {item.content.map((li: string) => {
                    const html = li
                      .replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>')
                      .replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                    return <li set:html={html} />;
                  })}
                </ul>
              ) : item.type === 'heading-serif' ? (
                item.content.map((h: string) => (
                  <p class="text-[var(--color-text-primary)] text-[20px] md:text-[24px] leading-[1.2] font-(family-name:--font-instrument-serif)">{h}</p>
                ))
              ) : item.type === 'quote' ? (
                item.content.map((q: string) => {
                  const html = q
                    .replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>')
                    .replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                  return <p class={`text-[var(--color-text-primary)] leading-[1.2] text-center font-(family-name:--font-instrument-serif) py-4 ${html.length > 60 ? 'text-[18px] md:text-[20px]' : 'text-[20px] md:text-[24px]'}`} set:html={html} />;
                })
              ) : (
                item.content.map((p: string) => {
                  const html = p
                    .replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>')
                    .replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                  return <p class="text-[var(--color-text-secondary)] text-[13px] leading-relaxed font-(family-name:--font-inter)" set:html={html} />;
                })
              )
            ))}
          </div>
        )}
        {section.columns && (
          <div class={`grid grid-cols-1 gap-6 ${section.columns.length === 4 ? 'md:grid-cols-4' : section.columns.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
            {section.columns.map((col) => (
              <div class="flex flex-col gap-3">
                <p class="text-[var(--color-text-primary)] text-[20px] md:text-[24px] leading-[1.2] font-(family-name:--font-instrument-serif)">{col.heading}</p>
                <div class="flex flex-col gap-2 text-[var(--color-text-secondary)] text-[13px] leading-relaxed font-(family-name:--font-inter)">
                  {col.body.map((p: string) => {
                    const html = p
                      .replace(/~~(.+?)~~/g, '<span class="text-[var(--color-accent)]">$1</span>')
                      .replace(/\*\*(.+?)\*\*/g, '<span class="font-bold text-[var(--color-text-primary)]">$1</span>');
                    return <p set:html={html} />;
                  })}
                </div>
              </div>
            ))}
          </div>
        )}
        {section.image && (
          <>
            <ImageBlock image={section.image} />
            {section.image.caption && (
              <p class="text-[var(--color-text-secondary)] text-[13px] font-(family-name:--font-geist-mono) leading-[1.2] uppercase text-right">{section.image.caption}</p>
            )}
          </>
        )}
      </div>
      )
    ))}
  </div>
</div>

<Lightbox />
