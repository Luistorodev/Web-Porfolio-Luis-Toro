---
import { leftColumn, rightColumn } from '../data/projects';
import { ui, type Language } from '../data/i18n';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
---

<section aria-labelledby="projects-heading" class="flex flex-col items-start w-full">
  {/* Visually hidden heading: keeps the document outline logical without altering the design. */}
  <h2 id="projects-heading" class="sr-only">{ui[lang].projectsSection}</h2>
  <div class="flex flex-col md:flex-row gap-8 justify-center px-4 md:px-6 w-full">
    {/* Desktop Left Column */}
    <div class="hidden md:flex flex-1 flex-col gap-8 min-w-0">
      {leftColumn.map((item) => (
        <ProjectCard project={item} lang={lang} variant="fixed" />
      ))}
    </div>

    {/* Desktop Right Column */}
    <div class="hidden md:flex flex-1 flex-col gap-8 min-w-0">
      {rightColumn.map((item) => (
        <ProjectCard project={item} lang={lang} variant="stretch" />
      ))}
    </div>

    {/* Mobile: Single column, interleaved */}
    <div class="flex md:hidden flex-col gap-8 w-full">
      {leftColumn.map((item, i: number) => (
        <>
          <ProjectCard project={item} lang={lang} variant="mobile" />
          {rightColumn[i] && (
            <ProjectCard project={rightColumn[i]} lang={lang} variant="mobile" />
          )}
        </>
      ))}
    </div>
  </div>
</section>
