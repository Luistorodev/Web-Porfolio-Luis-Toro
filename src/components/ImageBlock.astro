---
import type { ProjectImage } from '../data/legalTechContent';

interface Props {
  image: ProjectImage;
}

const { image } = Astro.props;
---

{image.contain ? (
  <div class="relative w-full">
    <img src={image.src} alt="" class="w-full h-auto object-contain" />
    {image.caption && (
      <p class="text-[#6b7280] text-[13px] font-['Geist_Mono'] leading-[1.2] mt-2 uppercase text-right">{image.caption}</p>
    )}
  </div>
) : (
  <div class="relative w-full">
    {!image.height ? (
      <>
        <div style={`padding-bottom: ${image.tall ? '187.03%' : '55.844%'}`}></div>
        <div class="absolute inset-0">
          <img src={image.src} alt="" class="absolute inset-0 w-full h-full object-cover" />
          {image.overlay && (
            <div aria-hidden="true" class="absolute inset-0">
              <img src={image.overlay.src} alt="" class="w-full h-full object-cover" />
              <div class="absolute inset-0" style={`background: rgba(0,0,0,${image.overlay.opacity || '0.33'})`}></div>
            </div>
          )}
          {image.logo && (
            <div class="absolute inset-0 flex items-center justify-center">
              <img src={image.logo} alt="" class="h-[60px] w-auto max-w-[300px] object-contain" />
            </div>
          )}
          {image.composites && image.composites.map((comp) => (
            <div class="absolute" style={`width: ${comp.width}; top: ${comp.top}; left: ${comp.left};`}>
              <img src={comp.src} alt="" class="w-full object-cover" />
            </div>
          ))}
        </div>
        {image.caption && (
          <p class="text-[#6b7280] text-[13px] font-['Geist_Mono'] leading-[1.2] mt-2 uppercase text-right">{image.caption}</p>
        )}
      </>
    ) : (
      <>
        <div style={`height: ${image.height}`}>
          <img src={image.src} alt="" class="w-full h-full object-cover" />
          {image.overlay && (
            <div aria-hidden="true" class="absolute inset-0">
              <img src={image.overlay.src} alt="" class="w-full h-full object-cover" />
              <div class="absolute inset-0" style={`background: rgba(0,0,0,${image.overlay.opacity || '0.33'})`}></div>
            </div>
          )}
          {image.logo && (
            <div class="absolute inset-0 flex items-center justify-center">
              <img src={image.logo} alt="" class="h-[60px] w-auto max-w-[300px] object-contain" />
            </div>
          )}
          {image.composites && image.composites.map((comp) => (
            <div class="absolute" style={`width: ${comp.width}; top: ${comp.top}; left: ${comp.left};`}>
              <img src={comp.src} alt="" class="w-full object-cover" />
            </div>
          ))}
        </div>
        {image.caption && (
          <p class="text-[#6b7280] text-[13px] font-['Geist_Mono'] leading-[1.2] mt-2 uppercase text-right">{image.caption}</p>
        )}
      </>
    )}
  </div>
)}
