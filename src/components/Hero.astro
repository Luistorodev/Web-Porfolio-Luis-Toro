---
import { Image } from 'astro:assets';
import { ui, type Language } from '../data/i18n';
import profilePhoto from '../assets/hero/luis-toro-profile.png';
import logoBudweiser from '../assets/logos/budweiser.png';
import logoCusquena from '../assets/logos/cusquena.png';
import logoCristal from '../assets/logos/cristal.png';
import logoScotiabank from '../assets/logos/scotiabank.png';
import logoOntop from '../assets/logos/ontop.png';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const copy = ui[lang].hero;
---

<div class="flex flex-col md:flex-row gap-4 md:gap-4 items-center justify-center w-full px-4 md:px-0">
  <!-- Profile photo (LCP candidate: eager + high priority) -->
  <Image
    src={profilePhoto}
    alt="Luis Toro"
    widths={[120, 181, 240, 362]}
    sizes="(min-width: 768px) 181px, 120px"
    format="webp"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="h-[140px] w-[120px] md:h-[210px] md:w-[181px] rounded-xs object-cover shrink-0"
  />

  <div class="flex flex-row items-center self-stretch">
    <div class="flex flex-col gap-6 md:gap-8 h-full justify-center">
      <!-- Name + Description + Location -->
        <div class="flex flex-col gap-2">
          <div class="flex flex-col gap-2 text-center md:text-left">
            <h1 class="font-bold text-[var(--color-text-primary)] text-[24px] md:text-[31px] leading-tight font-(family-name:--font-inter)">
              {copy.title}
            </h1>
            <p class="text-[var(--color-text-secondary)] text-[13px] leading-tight max-w-[500px] font-(family-name:--font-inter)">
              {copy.description}
            </p>
          </div>

          <!-- Location -->
          <div class="flex gap-1 items-center justify-center md:justify-start font-(family-name:--font-inter)">
            <img src="/assets/map-pin-icon.svg" alt={copy.locationAlt} class="w-[17px] h-[17px] dark-invert" />
            <p class="text-[var(--color-text-strong)] text-[13px] leading-tight whitespace-nowrap">{copy.location}</p>
          </div>
        </div>

        <!-- Companies -->
        <div class="flex flex-col gap-0.5 items-center md:items-start">
          <h2 class="text-[var(--color-text-muted)] text-[12px] md:text-[14px] uppercase whitespace-nowrap font-(family-name:--font-geist-mono)">
            {copy.trustedBy}
          </h2>
          <div class="flex flex-wrap justify-center md:justify-start gap-4 md:gap-[32px] items-start">
            <!-- Finsocial -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] shrink-0 flex items-center justify-center">
              <img src="/assets/logo_finsocial-1.svg" alt="Finsocial" class="dark-invert w-[57px] md:w-[77px] h-auto" />
            </div>
            <!-- Budweiser -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <Image src={logoBudweiser} alt="Budweiser" widths={[73, 146]} sizes="73px" format="webp" loading="lazy" decoding="async" class="dark-invert absolute left-[3px] md:left-[3.5px] top-[10px] md:top-[13px] w-[54px] md:w-[73px] h-[19px] md:h-[24px]" />
            </div>
            <!-- Cusqueña -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <Image src={logoCusquena} alt="Cusqueña" widths={[76, 152]} sizes="76px" format="webp" loading="lazy" decoding="async" class="dark-invert absolute left-[1.5px] top-[9px] md:top-[12px] w-[57px] md:w-[76px] h-[21px] md:h-[26px]" />
            </div>
            <!-- Cristal -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <Image src={logoCristal} alt="Cristal" widths={[71, 142]} sizes="71px" format="webp" loading="lazy" decoding="async" class="dark-invert absolute left-[3px] md:left-[4.5px] top-[9px] md:top-[12px] w-[54px] md:w-[71px] h-[20px] md:h-[25px]" />
            </div>
            <!-- Scotiabank -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <Image src={logoScotiabank} alt="Scotiabank" widths={[77, 154]} sizes="77px" format="webp" loading="lazy" decoding="async" class="dark-invert absolute left-[1.5px] top-[15px] md:top-[19px] w-[57px] md:w-[77px] h-[9px] md:h-[11px]" />
            </div>
            <!-- Círculo de Crédito -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <img src="/assets/77bfa299a5c1c5cac23d453c58a397e3c475f660.svg" alt="Círculo de Crédito" class="dark-invert absolute left-[3px] md:left-[3.5px] top-[9px] md:top-[12px] w-[54px] md:w-[72px] h-[20px] md:h-[25px]" />
            </div>
            <!-- Ontop -->
            <div class="w-[60px] h-[40px] md:w-[79px] md:h-[49px] relative shrink-0">
              <Image src={logoOntop} alt="Ontop" widths={[73, 146]} sizes="73px" format="webp" loading="lazy" decoding="async" class="dark-invert absolute left-[3px] md:left-[3.5px] top-[13px] md:top-[16px] w-[54px] md:w-[73px] h-[14px] md:h-[18px]" />
            </div>
          </div>
        </div>
    </div>
  </div>
</div>
